# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Anthropic API key, used ONLY by the text-to-SQL assistant (src/text2sql).
# Get one at https://console.anthropic.com/. The rest of the pipeline
# (ingestion, EDA, segmentation, forecasting, API, dashboard) runs without it.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for SQL generation + answer synthesis.
TEXT2SQL_MODEL=claude-opus-4-8

# Base URL the Streamlit dashboard uses to reach the FastAPI service.
API_BASE_URL=http://127.0.0.1:8000
