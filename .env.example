# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Groq API key, used ONLY by the text-to-SQL assistant (src/text2sql).
# Free key at https://console.groq.com — no credit card required. The rest of the
# pipeline (ingestion, EDA, segmentation, forecasting, API, dashboard) runs without it.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for SQL generation + answer synthesis (Groq-hosted). gpt-oss-120b is
# the strongest general chat model on Groq's free tier; qwen/qwen3.8-27b also works.
TEXT2SQL_MODEL=openai/gpt-oss-120b

# Base URL the Streamlit dashboard uses to reach the FastAPI service.
API_BASE_URL=http://127.0.0.1:8000
